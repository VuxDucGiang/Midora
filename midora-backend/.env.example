# Copy this file to .env on EC2 and fill in real values. NEVER commit .env to Git.
SPRING_PROFILES_ACTIVE=prod

# Amazon RDS MySQL Endpoint (replace <RDS_ENDPOINT>, <DB_USER>, <DB_PASSWORD>)
SPRING_DATASOURCE_URL=jdbc:mysql://<RDS_ENDPOINT>:3306/midora_db?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=<DB_USER>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>

# Generate a strong random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=<REPLACE_WITH_64_CHAR_HEX_SECRET>

# Comma-separated frontend URLs allowed by CORS (no trailing slash)
CORS_ALLOWED_ORIGINS=https://<YOUR_FRONTEND_DOMAIN>,http://localhost:3000

